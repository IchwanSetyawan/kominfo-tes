SELECT 
    users.id AS user_id,
    users.username,
    courses.course,
    courses.mentor,
    courses.title
FROM 
    userCourse
JOIN 
    users ON userCourse.id_user = users.id
JOIN 
    courses ON userCourse.id_course = courses.id;


SELECT 
    users.id AS user_id,
    users.username,
    courses.course,
    courses.mentor,
    courses.title
FROM 
    userCourse
JOIN 
    users ON userCourse.id_user = users.id
JOIN 
    courses ON userCourse.id_course = courses.id
WHERE 
    courses.title LIKE 'S.%';


SELECT 
    users.id AS user_id,
    users.username,
    courses.course,
    courses.mentor,
    courses.title
FROM 
    userCourse
JOIN 
    users ON userCourse.id_user = users.id
JOIN 
    courses ON userCourse.id_course = courses.id
WHERE 
    courses.title NOT LIKE 'S.%';
    
SELECT 
    courses.course AS course_name,
    courses.mentor,
    courses.title,
    COUNT(userCourse.id_user) AS jumlah_peserta
FROM 
    userCourse
JOIN 
    courses ON userCourse.id_course = courses.id
GROUP BY 
    courses.course, courses.mentor, courses.title;

SELECT 
    courses.mentor,
    COUNT(userCourse.id_user) AS jumlah_peserta,
    COUNT(userCourse.id_user) * 2000000 AS total_fee
FROM 
    userCourse
JOIN 
    courses ON userCourse.id_course = courses.id
GROUP BY 
    courses.mentor;